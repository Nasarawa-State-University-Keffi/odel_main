DJANGO_ENV=production
DJANGO_SECRET_KEY=change-me-use-a-long-random-secret
DJANGO_ALLOWED_HOSTS=api.example.edu.ng

# Bare-metal Postgres connection from inside the Docker container.
# host.docker.internal is enabled in docker-compose.yml via extra_hosts.
DATABASE_URL=postgresql://lms_user:change-me@host.docker.internal:5432/lms_db

REDIS_PASSWORD=change-me

CORS_ALLOWED_ORIGINS=https://lms.example.edu.ng
CSRF_TRUSTED_ORIGINS=https://lms.example.edu.ng
# Use None for both while the frontend runs on localhost and the API is remote.
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

AUTHENTIK_ISSUER_URL=https://auth.example.edu.ng/application/o/lms/
AUTHENTIK_CLIENT_ID=change-me
AUTHENTIK_CLIENT_SECRET=change-me
AUTHENTIK_REDIRECT_URI=https://api.example.edu.ng/auth/oidc/callback
AUTHENTIK_SCOPES=openid profile email
OIDC_LOGIN_REDIRECT_URL=https://lms.example.edu.ng/dashboard
OIDC_LOGOUT_REDIRECT_URL=https://lms.example.edu.ng/login

PORTAL_SYNC_BASE_URL=https://test.nsuk.edu.ng
PORTAL_SYNC_PUBLIC_KEY=change-me
PORTAL_SYNC_PRIVATE_KEY=change-me
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@lms.example.edu.ng

RUN_MIGRATIONS=1
RUN_COLLECTSTATIC=1
CELERY_WORKER_CONCURRENCY=4
