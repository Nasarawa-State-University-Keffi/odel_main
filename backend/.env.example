# ====================================
# Django Configuration
# ====================================
DJANGO_ENV=development  # Options: development, staging, production
DJANGO_SECRET_KEY=your-secret-key-here-generate-with-python-secrets
DJANGO_DEBUG=1  # Set to 0 in production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ====================================
# Database Configuration
# ====================================
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://lms_user:changeme@db:5432/lms_db
POSTGRES_DB=lms_db
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=changeme

# Portal Database (Read-only for syncing student data)
PORTAL_DB_ENGINE=django.db.backends.postgresql
PORTAL_DB_NAME=portal_db
PORTAL_DB_USER=portal_user
PORTAL_DB_PASSWORD=portal_password
PORTAL_DB_HOST=portal_host
PORTAL_DB_PORT=5432

# ====================================
# Redis Configuration
# ====================================
REDIS_PASSWORD=redispass
REDIS_URL=redis://:redispass@redis:6379/1

# ====================================
# Celery Configuration
# ====================================
CELERY_BROKER_URL=redis://:redispass@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redispass@redis:6379/0

# ====================================
# Zoom Integration
# ====================================
ZOOM_API_KEY=your_zoom_api_key
ZOOM_API_SECRET=your_zoom_api_secret
ZOOM_WEBHOOK_SECRET=your_zoom_webhook_secret

# ====================================
# Email Configuration (for production)
# ====================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@lms.example.com

# Resend & Brevo API Keys
RESEND_API_KEY=re_your_api_key
BREVO_API_KEY=xkeysib-your_api_key

# ====================================
# CORS Configuration
# ====================================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://lms.example.edu.ng
# Comma-separated list of origins trusted for CSRF-protected session requests
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://lms.example.edu.ng

# ====================================
# Storage Backend Credentials
# ====================================
# NOTE: Choose your storage backend in the database via StorageSettings model
# Only the credentials for your chosen backend need to be configured

# AWS S3 Storage
# Required if using 's3' backend
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your_bucket_name
AWS_S3_REGION_NAME=us-east-1

# Cloudinary Storage
# Required if using 'cloudinary' backend
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# YouTube Integration
# Required if using 'youtube' backend (for video references)
YOUTUBE_API_KEY=your_youtube_api_key

# ====================================
# Flower Monitoring
# ====================================
# Credentials for Celery monitoring dashboard
FLOWER_USER=admin
FLOWER_PASSWORD=admin

# ====================================
# Admin Panel
# ====================================
# Custom URL for admin panel (change for security)
ADMIN_URL=admin/

# ====================================
# Security Settings
# ====================================
# Enable in production
SECURE_SSL_REDIRECT=False
# Keep active LMS sessions alive for 24 hours since the user's last request.
SESSION_COOKIE_AGE_SECONDS=86400
SESSION_SAVE_EVERY_REQUEST=True

# ====================================
# Logging
# ====================================
DJANGO_LOG_LEVEL=INFO

# ====================================
# Portal server-to-server synchronization
# ====================================
PORTAL_SYNC_BASE_URL=https://test.nsuk.edu.ng
PORTAL_SYNC_PUBLIC_KEY=your-portal-public-key
PORTAL_SYNC_PRIVATE_KEY=your-portal-private-key
# ====================================
# Authentik OIDC SSO Integration
# ====================================
AUTHENTIK_ISSUER_URL=https://auth.example.edu.ng/application/o/lms/
AUTHENTIK_CLIENT_ID=your-authentik-client-id
AUTHENTIK_CLIENT_SECRET=your-authentik-client-secret
AUTHENTIK_REDIRECT_URI=https://lms.example.edu.ng/auth/oidc/callback
AUTHENTIK_SCOPES=openid profile email
OIDC_LOGIN_REDIRECT_URL=/dashboard
