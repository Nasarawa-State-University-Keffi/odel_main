# Django settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Zoom API credentials
ZOOM_API_KEY=your_zoom_api_key
ZOOM_API_SECRET=your_zoom_api_secret
ZOOM_WEBHOOK_SECRET=your_zoom_webhook_secret

# Celery (automatically set in docker-compose.yml)
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# Portal Database (configure as needed)
PORTAL_DB_ENGINE=django.db.backends.postgresql
PORTAL_DB_NAME=portal_db
PORTAL_DB_USER=portal_user
PORTAL_DB_PASSWORD=portal_password
PORTAL_DB_HOST=portal_host
PORTAL_DB_PORT=5432
