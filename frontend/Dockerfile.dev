FROM node:20-alpine

WORKDIR /app

# Install dependencies first for better caching
COPY package*.json ./
RUN npm install

# Copy the rest of the application
COPY . .

# Expose port 8080 (matching vite.config.ts)
EXPOSE 8080

# Start Vite with --host to allow external access
CMD ["npm", "run", "dev", "--", "--host"]
